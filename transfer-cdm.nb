      RowBox[{"(", 
       RowBox[{"-", "3"}], ")"}]}], "+", 
     FractionBox["\[CapitalOmega]\[CapitalLambda]", "\[CapitalOmega]m"]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ht", "[", "a_", "]"}], ":=", 
  RowBox[{"a", "*", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"H2", "[", "a", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
