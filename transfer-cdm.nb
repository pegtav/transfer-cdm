 RowBox[{
  RowBox[{"aeq", "=", 
   FractionBox[
    RowBox[{"4.15", "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "5"}], ")"}]}]}], 
    RowBox[{"\[CapitalOmega]m", "*", 
     RowBox[{"h", "^", "2"}]}]]}], ";"}], "\[IndentingNewLine]", 
