Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "[", "x_", "]"}], ":=", 
  RowBox[{"SetPrecision", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{"0.171", "*", "x"}]}], "]"}], 
      RowBox[{"0.171", "*", "x"}]], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"0.284", "*", "x"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1.18", "*", "x"}], ")"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0.399", "*", "x"}], ")"}], "^", "3"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0.490", "*", "x"}], ")"}], "^", "4"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"-", "0.25"}], ")"}]}]}], ",", "50"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rangeX", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Subdivide", "[", 
      RowBox[{"0.01", ",", "10.", ",", "200"}], "]"}], ",", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"10.", "+", "0.01"}], ",", "1000.", ",", "100"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TBBKS", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"T", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "rangeX"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.861196581064308*^9, 3.8611966527663107`*^9}, {
