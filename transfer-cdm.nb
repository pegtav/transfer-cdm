Cell[TextData[{
 "BBKS Transfer Function - ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "(", 
         RowBox[{
           StyleBox["x", "TI"], "\[LongEqual]", 
           FractionBox[
            StyleBox["k", "TI"], 
            SubscriptBox[
             StyleBox["k", "TI"], 
             StyleBox["eq", FontSlant -> "Plain"]]]}], ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
