Cell[BoxData[
 RowBox[{"\[CapitalLambda]CDM", "=", 
  RowBox[{"ParametricNDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{
          RowBox[{"\[CapitalTheta]r0", "'"}], "[", "a", "]"}]}], "+", 
        RowBox[{"k", "*", 
         RowBox[{"\[CapitalTheta]r1", "[", "a", "]"}]}]}], "==", 
       RowBox[{
        RowBox[{"-", "a"}], "*", 
        RowBox[{"Ht", "[", "a", "]"}], "*", 
        RowBox[{
         RowBox[{"\[CapitalPhi]", "'"}], "[", "a", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{
          RowBox[{"\[CapitalTheta]r1", "'"}], "[", "a", "]"}]}], "-", 
        RowBox[{
         FractionBox["k", "3."], "*", 
         RowBox[{"\[CapitalTheta]r0", "[", "a", "]"}]}]}], "==", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "k"}], "3."], "*", 
        RowBox[{"\[CapitalPhi]", "[", "a", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{
          RowBox[{"\[Delta]", "'"}], "[", "a", "]"}]}], "-", 
        RowBox[{"k", "*", 
         RowBox[{"v", "[", "a", "]"}]}]}], "==", 
       RowBox[{
        RowBox[{"-", "3."}], "*", "a", "*", 
        RowBox[{"Ht", "[", "a", "]"}], "*", 
        RowBox[{
         RowBox[{"\[CapitalPhi]", "'"}], "[", "a", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{
          RowBox[{"v", "'"}], "[", "a", "]"}]}], "+", 
        RowBox[{
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{"v", "[", "a", "]"}]}]}], "==", 
       RowBox[{"k", "*", 
        RowBox[{"\[CapitalPhi]", "[", "a", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"k", "^", "2"}], "*", 
         RowBox[{"\[CapitalPhi]", "[", "a", "]"}]}], "+", 
        RowBox[{"3.", "*", 
         RowBox[{"Ht", "[", "a", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", "*", 
            RowBox[{"Ht", "[", "a", "]"}], "*", 
            RowBox[{
             RowBox[{"\[CapitalPhi]", "'"}], "[", "a", "]"}]}], "+", 
           RowBox[{
            RowBox[{"Ht", "[", "a", "]"}], "*", 
            RowBox[{"\[CapitalPhi]", "[", "a", "]"}]}]}], ")"}]}]}], "==", 
       RowBox[{"1.5", "*", 
        RowBox[{
         RowBox[{"Ht", "[", "a", "]"}], "^", "2"}], "*", 
        FractionBox[
         RowBox[{"y", "[", "a", "]"}], 
         RowBox[{"1.", "+", 
          RowBox[{
           RowBox[{"y", "[", "a", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              
              FractionBox["\[CapitalOmega]\[CapitalLambda]", 
               "\[CapitalOmega]m"], "*", 
              RowBox[{"a", "^", "3"}]}]}], ")"}]}]}]], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Delta]", "[", "a", "]"}], "+", 
          RowBox[{
           FractionBox["4.", 
            RowBox[{"y", "[", "a", "]"}]], "*", 
           RowBox[{"\[CapitalTheta]r0", "[", "a", "]"}]}]}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "[", "ai", "]"}], "==", 
       RowBox[{"2.", "*", 
        RowBox[{"\[CapitalTheta]r0", "[", "ai", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"\[Delta]", "[", "ai", "]"}], "==", 
       RowBox[{"3.", "*", 
        RowBox[{"\[CapitalTheta]r0", "[", "ai", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"v", "[", "ai", "]"}], "==", 
       RowBox[{
        FractionBox["k", 
